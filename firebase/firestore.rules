rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function participant(conversationId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/appConversations/$(conversationId)).data.participants;
    }

    match /profiles/{uid} {
      allow create: if self(uid)
        && request.resource.data.uid == uid
        && request.resource.data.messagesId is string
        && request.resource.data.messagesId.matches('MSOM-[A-Z0-9]{8}');
      allow read: if signedIn();
      allow update: if self(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.messagesId == resource.data.messagesId;
      allow delete: if false;
    }

    match /appConversations/{conversationId} {
      allow read: if participant(conversationId);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if participant(conversationId)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if participant(conversationId);
        allow create: if participant(conversationId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.recipientUid in resource.data.participants;
        allow update: if participant(conversationId)
          && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
        allow delete: if false;
      }
    }
  }
}
